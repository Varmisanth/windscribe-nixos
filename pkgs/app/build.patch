diff --git a/CMakeLists.txt b/CMakeLists.txt
index db7cd90..931bbde 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -5,6 +5,9 @@
 
 cmake_minimum_required(VERSION 3.23)
 
+# windscribe-nixos: silence "unused variable" warnings for vars from nixpkgs cmake setup hook
+set(_nix_compat_vars "${BUILD_TESTING}${CMAKE_EXPORT_NO_PACKAGE_REGISTRY}")
+
 set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)  # option() honors normal variables
 
 # Set macOS deployment target and architecture before project()
@@ -213,20 +216,15 @@ endif()
 # leaving VCPKG_ROOT unset. Defined only here so an unguarded use fails to compile rather than
 # silently getting "".
 if(BUILD_APP)
-    ws_resolve_openvpn_version(WS_OPENVPN_VERSION)
+    if(NOT WS_OPENVPN_VERSION)
+        ws_resolve_openvpn_version(WS_OPENVPN_VERSION)
+    endif()
     add_compile_definitions(WS_OPENVPN_VERSION="${WS_OPENVPN_VERSION}")
 
     # Resolved here rather than next to ws_resolve_shared_libs() below, because the names are needed
     # by the branding definitions that follow and by the subdirectories those definitions reach.
     if(NOT WIN32)
-        ws_resolve_openssl_libs()
-        if(APPLE)
-            # Not in the branding block below: the value is platform-specific, so a WS_MAC_ name must
-            # not be defined anywhere it would hold something other than the macOS one.
-            add_compile_definitions(WS_MAC_HELPER_FRAMEWORK_FILES="${WS_OPENSSL_SSL_LIB} ${WS_OPENSSL_CRYPTO_LIB}")
-        else()
-            list(APPEND WS_LINUX_RPATH_BINARIES "lib/${WS_OPENSSL_SSL_LIB}" "lib/${WS_OPENSSL_CRYPTO_LIB}")
-        endif()
+        # windscribe-nixos: OpenSSL comes from nixpkgs, there is no vcpkg tree to copy or repath.
     endif()
 endif()
 
diff --git a/cmake/integrations/windscribe.cmake b/cmake/integrations/windscribe.cmake
index 9b9a7c3..36fadf6 100644
--- a/cmake/integrations/windscribe.cmake
+++ b/cmake/integrations/windscribe.cmake
@@ -97,21 +97,21 @@ elseif(UNIX)
 endif()
 
 set(WS_LINUX_APP_TARGETS
-    ${WS_APP_TARGET} ${WS_CLI_TARGET} helper)
+    ${WS_APP_TARGET} helper)
 
 # Additional subdirectories to build (beyond client and helper which are always built).
 if(UNIX AND NOT APPLE)
-    set(WS_ADDITIONAL_SUBDIRS src/windscribe-cli)
+    set(WS_ADDITIONAL_SUBDIRS)
 endif()
 
 # Binaries that need RPATH set to ${WS_LINUX_INSTALL_DIR}/lib.
 # Paths are relative to ${WS_LINUX_INSTALL_DIR}.
 set(WS_LINUX_RPATH_BINARIES
     ${WS_APP_EXECUTABLE_NAME}
-    ${WS_CLI_EXECUTABLE_NAME}
     helper
     ${WS_PRODUCT_NAME_LOWER}openvpn
     lib/libwsnet.so
 )
+set(WS_BUNDLED_HELPER_NAMES)
 # The bundled OpenSSL libraries belong in this list too, but their names are only known once
 # ws_resolve_openssl_libs() has run, so the root CMakeLists appends them.
