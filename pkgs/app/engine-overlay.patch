+QJsonObject Engine::readDeclarativeSettings()
+{
+    const QStringList declPaths = {
+        QDir::homePath() + "/.config/windscribe/settings.json",
+        "/etc/windscribe/settings.json"
+    };
+    for (const QString &path : declPaths) {
+        QFile decl(path);
+        if (!decl.exists() || !decl.open(QIODevice::ReadOnly))
+            continue;
+        const QJsonDocument doc = QJsonDocument::fromJson(decl.readAll());
+        decl.close();
+        if (doc.isObject())
+            return doc.object();
+    }
+    return QJsonObject();
+}
+
+void Engine::applyDeclarativeRobertOverlay(const QVector<api_responses::RobertFilter> &filters)
+{
+    const QJsonObject obj = readDeclarativeSettings();
+    if (!obj.contains("robert") || !obj["robert"].isObject())
+        return;
+    const QJsonObject robertConfig = obj["robert"].toObject();
+    if (robertConfig.isEmpty())
+        return;
+
+    for (const api_responses::RobertFilter &filter : filters) {
+        if (!robertConfig.contains(filter.id) || !robertConfig[filter.id].isDouble())
+            continue;
+        const int desired = robertConfig[filter.id].toInt();
+        if (filter.status == desired)
+            continue;
+        api_responses::RobertFilter updated = filter;
+        updated.status = desired;
+        setRobertFilterImpl(updated);
+    }
+}
