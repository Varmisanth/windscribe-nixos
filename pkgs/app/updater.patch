+    // windscribe-nixos: query our flake repository on GitHub instead of upstream Windscribe API
+    static QNetworkAccessManager *nam = nullptr;
+    if (!nam) nam = new QNetworkAccessManager(this);
+
+    QNetworkRequest req(QUrl("https://api.github.com/repos/Varmisanth/windscribe-nixos/tags"));
+    req.setHeader(QNetworkRequest::UserAgentHeader, "windscribe-nixos");
+    QNetworkReply *reply = nam->get(req);
+
+    connect(reply, &QNetworkReply::finished, this, [this, reply]() {
+        QByteArray data = reply->readAll();
+        reply->deleteLater();
+
+        QJsonDocument doc = QJsonDocument::fromJson(data);
+        QJsonArray tags = doc.array();
+        QString latestVersion;
+        if (!tags.isEmpty()) {
+            QString tagName = tags.first().toObject()["name"].toString();
+            latestVersion = tagName.startsWith("v") ? tagName.mid(1) : tagName;
+            int dashIdx = latestVersion.indexOf("-");
+            if (dashIdx != -1) latestVersion = latestVersion.left(dashIdx);
+        }
 
