-                                                           osVersion.toStdString(), osBuild.toStdString());
+        // windscribe-nixos: flake handles upgrades, keep flag off.
+        bool updateNeeded = false;
+
+        QJsonObject payload;
+        payload["update_needed_flag"] = updateNeeded ? 1 : 0;
+        payload["latest_version"] = latestVersion;
+        payload["is_beta"] = 0;
+        payload["latest_build"] = 0;
+        payload["update_url"] = "https://github.com/Varmisanth/windscribe-nixos";
+        payload["supported"] = 1;
+        QJsonObject root;
+        root["data"] = payload;
+        QString jsonStr = QJsonDocument(root).toJson(QJsonDocument::Compact);
+
+        api_responses::CheckUpdate update(jsonStr.toStdString());
+        onCheckUpdateUpdated(update);
+    });
 }
 
